<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape><stroke android:width="3dp" android:color="@color/moving" /><corners android:radius="6dp" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><stroke android:width="2dp" android:color="@color/accent" /><corners android:radius="6dp" /></shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
